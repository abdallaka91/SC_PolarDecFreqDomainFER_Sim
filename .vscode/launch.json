{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Simul",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Simul",
            // "validate: NbMonteCarlo, SNR, sig_mod(BPSK, CCSK_bin, CCSK_NB), q, N, K, nH, nL, offset, Pt1, Pt2"
            "args": [1000, -13, "CCSK_Bin", 128, 512, 384,32,32, 1.0, 100, 50],
            // "args": [100, -12.5, "CCSK_Bin", 128, 512, 384,32,32, 1.0],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build simulator",  // Ensure this task is defined in tasks.json
            "logging": {
                "engineLogging": true,
                "trace": true,
                "traceResponse": true
            }
        }
    ]
}
