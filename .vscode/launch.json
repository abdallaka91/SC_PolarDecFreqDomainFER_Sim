{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Sim2",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Sim2",
      "args": ["1000", "-5.5", "64", "16", "9"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "OMP_NUM_THREADS", "value": "1" }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "logging": {
        "engineLogging": true,
        "trace": true,
        "traceResponse": true
      }
    }
  ]
}
