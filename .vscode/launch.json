{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Sim2",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Sim2",
            // "validate: NbMonteCarlo, SNR, sig_mod(BPSK, CCSK_bin, CCSK_NB), q, N, K, nH, nL, offset"
            // "args": [10, -14.5, "CCSK_Bin", 256, 128, 112,36,72, 1.5],
            "args": [
                1000,
                -20.5,
                "CCSK_Bin",
                64,
                1024,
                42,
                14,
                28,
                1.5
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build simulator", // Ensure this task is defined in tasks.json
            "logging": {
                "engineLogging": false,
                "trace": false,
                "traceResponse": false
            }
        }
    ]
}