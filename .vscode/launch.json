{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CMake Build (F5)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build_debug/Sim2",
      "args": [
        "100",
        "-7.5",
        "64",
        "64",
        "42",
        "dec1",
        "20"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "OMP_NUM_THREADS",
          "value": "1"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Break on OpenMP parallel region",
          "text": "break __kmpc_fork_call"
        },
        {
          "description": "Break on while loop",
          "text": "break decoders_simulator.cpp:123"
        }
      ],
      "preLaunchTask": "cmake-build-debug",
      "miDebuggerPath": "/usr/bin/gdb"
    },
    {
      "name": "Run Release CMake Build (Ctrl+F5)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Sim2",
      "args": [
        "100",
        "-7.5",
        "64",
        "64",
        "42",
        "dec1",
        "20"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "OMP_NUM_THREADS",
          "value": "4"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "cmake-build-release"
    }
  ]
}